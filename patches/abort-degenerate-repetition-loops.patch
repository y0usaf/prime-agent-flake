diff --git a/packages/agent/test/loop-guard.test.ts b/packages/agent/test/loop-guard.test.ts
new file mode 100644
index 0000000..0c06951
--- /dev/null
+++ b/packages/agent/test/loop-guard.test.ts
@@ -0,0 +1,104 @@
+import {
+	type AssistantMessage,
+	type AssistantMessageEvent,
+	type Context,
+	type Model,
+	type Message,
+	type StreamFn,
+} from "@earendil-works/pi-ai";
+import { describe, expect, it, vi } from "vitest";
+import { agentLoop } from "../src/agent-loop.js";
+import type { AgentContext, AgentEvent, AgentLoopConfig, AgentMessage } from "../src/types.js";
+
+function usage() {
+	return {
+		input: 0,
+		output: 0,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 0,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function createModel() {
+	return {
+		api: "openai-responses" as const,
+		provider: "faux",
+		id: "loop-test",
+		name: "Loop Test",
+	} as unknown as Model<"openai-responses">;
+}
+
+const identityConverter = (messages: AgentMessage[]): Message[] =>
+	messages.map((m) => ({
+		role: m.role,
+		content: m.content.map((c) => (c.type === "text" ? { type: "text", text: c.text } : c)),
+	}));
+
+const SENTENCE = "Lets review the implementation details one more time. ";
+
+// Streams an endless run of identical sentences so the loop guard must abort it.
+function degenerateStreamFn(): StreamFn {
+	return async function* () {
+		const partial = (): AssistantMessage => ({
+			role: "assistant" as const,
+			content: [{ type: "text" as const, text: SENTENCE }],
+			api: "openai-responses" as const,
+			provider: "faux",
+			model: "loop-test",
+			usage: usage(),
+			stopReason: "stop",
+			timestamp: Date.now(),
+		});
+		yield { type: "start", partial: partial() } as AssistantMessageEvent;
+		let i = 0;
+		while (true) {
+			i++;
+			yield {
+				type: "text_delta",
+				contentIndex: 0,
+				delta: SENTENCE,
+				partial: {
+					role: "assistant" as const,
+					content: [{ type: "text" as const, text: SENTENCE.repeat(i) }],
+					api: "openai-responses" as const,
+					provider: "faux",
+					model: "loop-test",
+					usage: usage(),
+					stopReason: "stop",
+					timestamp: Date.now(),
+				},
+			} as AssistantMessageEvent;
+		}
+	};
+}
+
+describe("degenerate repetition-loop guard", () => {
+	it("aborts and marks stopReason loop_detected on repeated verbatim sentences", async () => {
+		const context: AgentContext = {
+			systemPrompt: "You are helpful.",
+			messages: [],
+			tools: [],
+		};
+		const config: AgentLoopConfig = {
+			model: createModel(),
+			convertToLlm: identityConverter,
+		};
+
+		const stream = agentLoop([{
+			role: "user" as const,
+			content: [{ type: "text", text: "Go" }],
+		} satisfies AgentMessage], context, config, undefined, degenerateStreamFn());
+		for await (const _event of stream) {
+			// consume
+		}
+
+		const messages = await stream.result();
+		const assistant = messages.find((m) => m.role === "assistant");
+		expect(assistant?.role).toBe("assistant");
+		if (assistant?.role === "assistant") {
+			expect(assistant.stopReason).toBe("loop_detected");
+			expect(assistant.errorMessage).toBe("Loop detected: degenerate repeated output");
+		}
+	});});
