@@ -0,0 +1,112 @@
+/**
+ * Shared keybinding → action resolution for the agents/resume roster.
+ *
+ * The full-screen agents view (AgentsViewMode) and the persistent left
+ * sidebar (AgentsSidebar) both drive the same roster. Historically each had its
+ * own keyboard dispatch: the full view handled `app.agents.*` (new/delete/
+ * rename/reply/program/open) plus navigation, while the sidebar only handled a
+ * reduced `app.sidebar.*` set — so ctrl+n / ctrl+x / ctrl+r worked in the
+ * agents view but not in the sidebar, and the sidebar kept its own divergent
+ * search/nav logic.
+ *
+ * This module is the single key-dispatch path: `resolveAgentsViewKeyAction`
+ * maps an input chunk + the current UI state to a `AgentsViewKeyAction`, and
+ * both consumers switch on the result. The sidebar therefore gets every
+ * agents-view keybinding (ctrl+n new, ctrl+x delete, ctrl+r rename, space
+ * reply, ctrl+o program, ctrl+c clear, up/down/page navigation, search text)
+ * for free — same keys, same roster, one dispatch implementation.
+ */
+
+/** A resolved roster input: what the focused consumer should do. */
+export type AgentsViewKeyAction =
+	| { type: "rename" }
+	| { type: "delete" }
+	| { type: "reply" }
+	| { type: "new" }
+	| { type: "program" }
+	| { type: "open" }
+	| { type: "followUp" }
+	| { type: "clear" }
+	| { type: "nav"; delta: number }
+	| { type: "cancel" }
+	| { type: "search-commit" }
+	| { type: "text"; data: string }
+	| { type: "none" };
+
+/** Minimal keybinding matcher both consumers satisfy. */
+export interface AgentsViewKeyMatcher {
+	matches(data: string, keybindingName: string): boolean;
+}
+
+/** UI state the dispatcher needs to apply the agents-view guards. */
+export interface AgentsViewKeyState {
+	/** The search/filter text is empty (rename/delete/reply/program/open require it). */
+	textEmpty: boolean;
+	/** A rename input is active (its keys go to the rename editor, not the roster). */
+	renameActive: boolean;
+	/** A reply composer is armed (new/program/open/nav are suppressed). */
+	replyActive: boolean;
+	/** Search cursor is at the end of the text (open is allowed while filtered). */
+	searchCursorAtEnd: boolean;
+	/** How many rows are visible, for page-up/page-down magnitude. */
+	visibleRows: number;
+	/** True while the sidebar search input is being edited (kept by the sidebar). */
+	searchActive?: boolean;
+}
+
+/**
+ * Resolve one input chunk to a roster action. The guards mirror the full
+ * agents view's handleInput exactly, so a key behaves the same in both UIs.
+ */
+export function resolveAgentsViewKeyAction(
+	data: string,
+	kb: AgentsViewKeyMatcher,
+	state: AgentsViewKeyState,
+): AgentsViewKeyAction {
+	if (state.renameActive) {
+		if (kb.matches(data, "tui.select.cancel")) return { type: "cancel" };
+		return { type: "text", data };
+	}
+	if (kb.matches(data, "app.clear")) {
+		return { type: "clear" };
+	}
+	if (state.textEmpty && kb.matches(data, "app.agents.rename")) {
+		return { type: "rename" };
+	}
+	if (state.textEmpty && kb.matches(data, "app.agents.delete")) {
+		return { type: "delete" };
+	}
+	if (state.textEmpty && kb.matches(data, "app.agents.reply")) {
+		return { type: "reply" };
+	}
+	if (!state.replyActive && kb.matches(data, "app.agents.new")) {
+		return { type: "new" };
+	}
+	if (state.replyActive && kb.matches(data, "app.message.followUp")) {
+		return { type: "followUp" };
+	}
+	if (state.textEmpty && kb.matches(data, "app.agents.program")) {
+		return { type: "program" };
+	}
+	if (!state.replyActive && kb.matches(data, "app.agents.open")) {
+		if (state.textEmpty || state.searchCursorAtEnd) {
+			return { type: "open" };
+		}
+	}
+	if (!state.replyActive && kb.matches(data, "tui.select.up")) {
+		return { type: "nav", delta: -1 };
+	}
+	if (!state.replyActive && kb.matches(data, "tui.select.down")) {
+		return { type: "nav", delta: 1 };
+	}
+	if (!state.replyActive && kb.matches(data, "tui.select.pageUp")) {
+		return { type: "nav", delta: -Math.max(1, state.visibleRows) };
+	}
+	if (!state.replyActive && kb.matches(data, "tui.select.pageDown")) {
+		return { type: "nav", delta: Math.max(1, state.visibleRows) };
+	}
+	if (state.searchActive && kb.matches(data, "tui.input.tab")) {
+		return { type: "search-commit" };
+	}
+	return { type: "text", data };
+}
