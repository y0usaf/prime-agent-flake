--- /dev/null
+++ b/packages/coding-agent/src/modes/agents-view/agents-view-render.ts
@@ -0,0 +1,259 @@
+/**
+ * Shared row-rendering pipeline for the agents/resume roster.
+ *
+ * The full-screen agents view (AgentsViewMode) and the persistent left
+ * sidebar (AgentsSidebar) both render the same unified roster. Historically the
+ * sidebar hand-rolled its own compact row renderer, which meant two divergent
+ * render paths for the same `AgentsViewRow` data. This module is the single
+ * render path: both consumers call `renderAgentsViewRow` / `finalizeAgentsViewLine`
+ * with the same options, so the sidebar is literally the agents view compressed
+ * to rail width — the same icon, styled title, summary suffix and age/details
+ * column, truncated to fit. (The only rail-specific option is
+ * `compactDeleteHint`, which shortens the delete-armed wording for the narrow
+ * column.)
+ *
+ * The renderer is pure: it takes an explicit render context (selection, working
+ * icon frame, pending delete/kill state) and returns marker-tagged lines that
+ * `finalizeAgentsViewLine` turns into final terminal rows (applying the
+ * selection background, truncating to exactly one row, etc.).
+ */
+
+import { truncateToWidth, visibleWidth } from "@earendil-works/pi-tui";
+import { keyText } from "../interactive/components/keybinding-hints.js";
+import { theme } from "../interactive/theme/theme.js";
+import { workingIconFrame } from "../interactive/theme/working-icon.js";
+import type { SessionSummary } from "../daemon/daemon-session-list.js";
+import {
+	formatHeartbeatBadge,
+	type AgentsViewRow,
+	type AgentsViewSection,
+} from "./agents-view-state.js";
+
+export const SELECTED_ROW_MARKER = "\0agents-view-selected-row\0";
+export const CODE_ROW_MARKER = "\0agents-view-code-row\0";
+
+/** Render options that differ between the full view and the narrow rail. */
+export interface AgentsViewRowRenderOptions {
+	/** Use the short "!delete?" armed-hint wording instead of the full-view
+	 *  "ctrl+x again to remove" (the narrow sidebar). */
+	compactDeleteHint?: boolean;
+}
+
+/** Render context for one row (state the renderer doesn't own). */
+export interface AgentsViewRowRenderContext {
+	width: number;
+	selected: boolean;
+	workingIconFrame: number;
+	options?: AgentsViewRowRenderOptions;
+	/** Identity of the row under a pending delete confirmation (full view only). */
+	pendingDeleteIdentity?: string;
+	/** Identity of the row under a pending subagent-kill confirmation (full view only). */
+	pendingKillIdentity?: string;
+	/** True while a delete/stop confirmation is visible. */
+	deleteConfirmationVisible?: boolean;
+	/** True when the pending delete already stopped the agent. */
+	pendingDeleteStopped?: boolean;
+	/** Bold the title of the row whose sessionId matches (sidebar current-session). */
+	highlightCurrentSessionId?: string;
+}
+
+/** Render a single roster row into a marker-tagged line. */
+export function renderAgentsViewRow(row: AgentsViewRow, ctx: AgentsViewRowRenderContext): string {
+	if (row.kind === "subagent-code") {
+		return renderCodeRow(row);
+	}
+	if (row.kind === "subagent-summary") {
+		const indent = "  ".repeat(row.depth);
+		const hint = row.hasSpawnCode
+			? theme.fg("dim", ` · ${keyText("app.agents.program")} show program`)
+			: "";
+		const label = `${theme.fg("dim", `▸ ${row.title}`)}${hint}`;
+		const line = padLine(truncateToWidth(`${indent}${label}`, ctx.width, ""), ctx.width);
+		return ctx.selected ? `${SELECTED_ROW_MARKER}${line}` : line;
+	}
+
+	const pendingDelete = row.kind === "agent" && isPendingDeleteRow(row, ctx);
+	const pendingKill = row.kind === "subagent" && isPendingKillSubagentRow(row, ctx);
+	const rawIcon = getRowIcon(row.section, ctx.workingIconFrame);
+	const icon = formatRowIcon(row.section, rawIcon);
+	const indent = "  ".repeat(row.depth);
+	const age = formatAgentsViewSessionDuration(row.summary);
+	const details = row.section === "inactive" ? `${row.summary.messageCount} · ${age}` : age;
+	const detailsWidth = row.section === "inactive" ? Math.max(10, visibleWidth(details)) : 10;
+	const heartbeatBadge = !pendingDelete && !pendingKill ? formatHeartbeatBadge(row.heartbeat) : "";
+	const heartbeatCell = heartbeatBadge ? theme.fg("error", heartbeatBadge) : "";
+	const heartbeatWidth = visibleWidth(heartbeatBadge);
+	const titleWidth = Math.max(
+		0,
+		ctx.width -
+			visibleWidth(indent) -
+			visibleWidth(rawIcon) -
+			detailsWidth -
+			2 -
+			(heartbeatWidth > 0 ? heartbeatWidth + 1 : 0),
+	);
+	const styledTitle = styleAgentsViewRowTitle(row);
+	const isCurrentHighlight =
+		ctx.highlightCurrentSessionId !== undefined && row.summary.sessionId === ctx.highlightCurrentSessionId;
+	const title = pendingDelete
+		? getPendingDeleteTitle(ctx)
+		: pendingKill
+			? `${keyText("app.agents.delete")} again to ${row.section === "running" ? "stop" : "delete"}`
+			: isCurrentHighlight && !ctx.selected
+				? theme.bold(styledTitle)
+				: styledTitle;
+	const summaryText = !pendingDelete && !pendingKill ? row.summary.summary : undefined;
+	const titleContent = summaryText ? `${title} ${theme.fg("dim", `· ${summaryText}`)}` : title;
+	const titleCell = formatTableCell(titleContent, titleWidth);
+	const cells = [
+		icon,
+		pendingDelete || pendingKill ? theme.fg("error", titleCell) : titleCell,
+		formatRightTableCell(details, detailsWidth),
+	];
+	const base = `${indent}${cells[0]} ${heartbeatCell ? `${heartbeatCell} ` : ""}${cells[1]} ${cells[2]}`;
+	const line = padLine(truncateToWidth(base, ctx.width, ""), ctx.width);
+	return ctx.selected ? `${SELECTED_ROW_MARKER}${line}` : line;
+}
+
+// Spawn-code rows are read-only context. They render deemphasized — muted
+// text on a panel background (applied in finalizeAgentsViewLine) so the program
+// reads as one quiet segmented block rather than competing with agent rows.
+function renderCodeRow(row: AgentsViewRow): string {
+	const indent = "  ".repeat(row.depth);
+	const body = theme.fg("muted", row.code || " ");
+	return `${CODE_ROW_MARKER}${indent}  ${body}`;
+}
+
+/** Turn a marker-tagged render line into a final single terminal row. */
+export function finalizeAgentsViewLine(line: string, width: number): string {
+	const code = line.startsWith(CODE_ROW_MARKER);
+	const selected = !code && line.startsWith(SELECTED_ROW_MARKER);
+	let content = code
+		? line.slice(CODE_ROW_MARKER.length)
+		: selected
+			? line.slice(SELECTED_ROW_MARKER.length)
+			: line;
+	// Each rendered line must occupy exactly one terminal row; a stray
+	// newline would shift every line below it and overlap the editor.
+	if (content.includes("\n") || content.includes("\r")) {
+		content = content.replace(/[\r\n]+/g, " ");
+	}
+	const padded = padLine(truncateToWidth(content, width), width);
+	if (code) {
+		return theme.bg("toolPanelBg", padded);
+	}
+	if (!selected) {
+		return padded;
+	}
+	// Truncating styled cells embeds full \x1b[0m resets; re-open the
+	// selection background after each so the highlight spans the whole row.
+	const applySelectionBg = theme.getSelectionBackgroundColor();
+	return padded.split("\x1b[0m").map(applySelectionBg).join("\x1b[0m");
+}
+
+function isPendingDeleteRow(row: AgentsViewRow, ctx: AgentsViewRowRenderContext): boolean {
+	return ctx.pendingDeleteIdentity !== undefined && row.identity === ctx.pendingDeleteIdentity && !!ctx.deleteConfirmationVisible;
+}
+
+function isPendingKillSubagentRow(row: AgentsViewRow, ctx: AgentsViewRowRenderContext): boolean {
+	return ctx.pendingKillIdentity !== undefined && row.identity === ctx.pendingKillIdentity && !!ctx.deleteConfirmationVisible;
+}
+
+function getPendingDeleteTitle(ctx: AgentsViewRowRenderContext): string {
+	if (ctx.options?.compactDeleteHint) {
+		return "!delete?";
+	}
+	const deleteKey = keyText("app.agents.delete");
+	return ctx.pendingDeleteStopped ? `stopped - ${deleteKey} again to remove` : `${deleteKey} again to remove`;
+}
+
+// Explicit session names read bold so they stand out from fallback titles
+// (first prompt, cwd, ids); the "(no messages)" placeholder reads italic.
+function styleAgentsViewRowTitle(row: AgentsViewRow): string {
+	if (row.summary.sessionName?.replace(/\s+/g, " ").trim()) {
+		return theme.bold(row.title);
+	}
+	if (row.title === "(no messages)") {
+		return theme.italic(row.title);
+	}
+	return row.title;
+}
+
+function formatTableCell(value: string, width: number): string {
+	const truncated = truncateToWidth(value, width, "");
+	return truncated + " ".repeat(Math.max(0, width - visibleWidth(truncated)));
+}
+
+function formatRightTableCell(value: string, width: number): string {
+	const truncated = truncateToWidth(value, width, "");
+	return " ".repeat(Math.max(0, width - visibleWidth(truncated))) + truncated;
+}
+
+function formatAgentsViewSessionDuration(summary: SessionSummary): string {
+	return formatAgentsViewRelativeTime(
+		summary.activeSessionId ? (summary.created ?? summary.modified) : (summary.modified ?? summary.created),
+	);
+}
+
+export function formatAgentsViewRelativeTime(value: string | undefined, now: number = Date.now()): string {
+	const timestamp = parseSessionTimestamp(value);
+	if (!timestamp) {
+		return "";
+	}
+	const seconds = Math.max(0, Math.floor((now - timestamp) / 1000));
+	if (seconds < 60) {
+		return `${seconds}s`;
+	}
+	const minutes = Math.floor(seconds / 60);
+	if (minutes < 60) {
+		return `${minutes}m`;
+	}
+	const hours = Math.floor(minutes / 60);
+	if (hours < 24) {
+		return `${hours}h`;
+	}
+	const days = Math.floor(hours / 24);
+	return `${days}d`;
+}
+
+function parseSessionTimestamp(value: string | undefined): number | undefined {
+	if (!value) {
+		return undefined;
+	}
+	const timestamp = Date.parse(value);
+	return Number.isNaN(timestamp) ? undefined : timestamp;
+}
+
+function padLine(line: string, width: number): string {
+	return line + " ".repeat(Math.max(0, width - visibleWidth(line)));
+}
+
+function getRowIcon(section: AgentsViewSection, frame: number): string {
+	switch (section) {
+		case "running":
+			return workingIconFrame(frame);
+		case "idle":
+			return "●";
+		case "inactive":
+			return "✓";
+		default: {
+			const _exhaustive: never = section;
+			return _exhaustive;
+		}
+	}
+}
+
+function formatRowIcon(section: AgentsViewSection, icon: string): string {
+	switch (section) {
+		case "running":
+			return theme.bold(icon);
+		case "idle":
+			return theme.fg("warning", icon);
+		case "inactive":
+			return theme.fg("dim", icon);
+		default: {
+			const _exhaustive: never = section;
+			return _exhaustive;
+		}
+	}
+}
